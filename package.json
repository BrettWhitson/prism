{
  "name": "prism",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Prism: a graphing and rendering engine. Give it nodes and edges; it styles and draws them on the GPU (WebGL2) and handles morphing, hover lineage, selection and export. Layout and physics come from Tether.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./*.js": {
      "types": "./types/*.d.ts",
      "default": "./src/*.js"
    },
    "./*": "./src/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node tools/serve.mjs",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run types:check && npm run docs:check && npm test",
    "types": "tsc -p . && prettier --write types --log-level warn",
    "typecheck": "tsc -p . --noEmit",
    "types:check": "node tools/check-types.mjs",
    "docs": "node tools/docs.mjs",
    "docs:check": "node tools/docs.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "tether": "github:BrettWhitson/tether#08ae83f728217fc64ae11fa1522540d0c54a7f1e"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "API.md",
    "LICENSE"
  ]
}
